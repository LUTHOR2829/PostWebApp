<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload New Picture</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <div class="w-fit border border-zinc-700 rounded-xl p-8 bg-zinc-800">

            <h3 class="text-3xl mb-5">Upload Profile Picture</h3>

            <form 
                autocomplete="off" 
                method="post" 
                action="/upload" 
                enctype="multipart/form-data"
                class="flex items-center gap-5">

                <input 
                    class="border border-zinc-600 rounded-md p-2 bg-zinc-900"
                    type="file" 
                    name="image">

                <input 
                    class="px-5 py-2 rounded-md bg-blue-500"
                    type="submit" 
                    value="Upload File">

            </form>

        </div>

    </div>
</body>
</html>