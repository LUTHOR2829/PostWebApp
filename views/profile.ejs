<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-900 text-white">

    <div class="w-full min-h-screen px-10 py-8">

        <!-- Logout -->
        <div class="flex justify-end">
            <a 
                class="bg-red-500 hover:bg-red-600 transition px-4 py-2 rounded-lg text-sm font-medium"
                href="/logout">
                Logout
            </a>
        </div>

        <!-- Profile Section -->
        <div class="mt-8 flex items-center gap-5">

            <!-- Profile Pic -->
            <div class="flex flex-col items-center">

                <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-zinc-700">
                    <img 
                        class="w-full h-full object-cover"
                        src="/images/uploads/<%= user.profilepic %>" 
                        alt="">
                </div>

                <a 
                    class="text-blue-400 text-sm mt-2 hover:underline"
                    href="/profile/upload">
                    Change Profile Pic
                </a>

            </div>

            <!-- Name -->
            <div>
                <h3 class="text-4xl font-semibold">
                    Hello,
                    <span class="font-light">
                        <%= user.name %>
                    </span>
                </h3>

                <p class="text-zinc-400 mt-1">
                    @<%= user.username %>
                </p>
            </div>

        </div>

        <!-- Create Post -->
        <div class="mt-10">

            <h5 class="text-lg mb-4 text-zinc-300">
                You can create a new post.
            </h5>

            <form action="/post" method="post">

                <textarea 
                    placeholder="What's on your mind ?" 
                    class="block p-4 outline-none w-full md:w-1/2 h-32 resize-none bg-zinc-800 border border-zinc-700 rounded-xl"
                    name="content"></textarea>

                <input 
                    class="px-5 py-3 text-sm bg-blue-500 hover:bg-blue-600 transition rounded-xl mt-4 cursor-pointer"
                    type="submit" 
                    value="Create New Post">

            </form>

        </div>

        <!-- Posts -->
        <div class="posts mt-16">

            <h3 class="text-2xl text-zinc-300 mb-6">
                Your Posts
            </h3>

            <div class="flex flex-wrap gap-5">

                <% user.posts.reverse().forEach((post) => { %>

                    <div class="w-full md:w-[32%] p-5 rounded-2xl border border-zinc-800 bg-zinc-950">

                        <h4 class="text-blue-400 mb-3 text-sm">
                            @<%= user.username %>
                        </h4>

                        <p class="text-sm leading-relaxed text-zinc-200">
                            <%= post.content %>
                        </p>

                        <small class="mt-4 inline-block text-zinc-400">
                            <%= post.likes.length %> Likes
                        </small>

                        <div class="flex gap-5 mt-3">

                            <a 
                                class="text-blue-500 hover:underline"
                                href="/like/<%= post._id %>">

                                <%= post.likes.indexOf(user._id)===-1 ? "Like" : "Unlike" %>

                            </a>

                            <a 
                                class="text-zinc-500 hover:text-zinc-300"
                                href="/edit/<%= post._id %>">

                                Edit

                            </a>

                        </div>

                    </div>

                <% }) %>

            </div>

        </div>

    </div>

</body>
</html>